*.tsbuildinfo
next-env.d.ts

# generated content (rebuilt by scripts/build-content.mjs)
/app/lib/_generated/

# documents de travail internes (retours client, notes)
*.pdf
doc.md

# donnees locales de dev (Blobs fallback)
/data
